# Caddyfile for reverse proxy config
{
  http_port 8000
}

# /api/auth and /api/tasks are mapboard.api; the rest of /api is mapboard_server,
# which verifies the session cookie itself and checks project access.
(apis) {
  handle_path /api/* {
    @platform path /auth/* /tasks/*
    handle @platform {
      reverse_proxy {$MAPBOARD_PLATFORM_API_ADDRESS:"api:8000"}
    }

    handle {
      reverse_proxy {$MAPBOARD_API_ADDRESS:"mapboard_server:8080"}
    }
  }
}

# PostgREST reads the session from an Authorization header, not a cookie.
(session-header) {
  @auth_cookie {
    header Cookie *access_token=*
    not header Authorization *
  }
  request_header @auth_cookie Authorization {http.request.cookie.access_token}
  request_header -Cookie
}

mapboard.local, :8000 {
  tls internal

  header {
    Access-Control-Allow-Origin *
    Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
  }

  handle_path /pg-api/* {
    import session-header

    # Match requests for GeoJSON files
    @geojson {
        path *.geojson
    }

    uri @geojson strip_suffix .geojson

    reverse_proxy @geojson postgrest:3000 {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Allow-Methods
      header_up Accept application/geo+json
    }

    reverse_proxy postgrest:3000 {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Allow-Methods
    }
  }

  import apis

  handle_path /dem-tiles/* {
    reverse_proxy elevation_tiler:8000 {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Allow-Methods
    }
  }

  handle_path /* {
    reverse_proxy frontend:3000
  }
}

dev.mapboard.local {
  tls internal

  # Mirror most services at dev.mapboard.local but point frontend to local host for development
  header {
    Access-Control-Allow-Origin *
    Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
  }

  handle_path /pg-api/* {
    import session-header

    # Match requests for GeoJSON files
    @geojson {
      path *.geojson
    }

    uri @geojson strip_suffix .geojson

    reverse_proxy @geojson postgrest:3000 {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Allow-Methods
      header_up Accept application/geo+json
    }

    reverse_proxy postgrest:3000 {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Allow-Methods
    }
  }

  import apis

  handle_path /dem-tiles/* {
    reverse_proxy elevation_tiler:8000 {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Allow-Methods
    }
  }

  handle_path /* {
    reverse_proxy docker.host.internal:3002
  }
}
